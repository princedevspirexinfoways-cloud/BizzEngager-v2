# ── Production env for docker-compose.prod.yml ───────────────────────
# Copy to .env.prod on the VPS and fill in real secrets. DO NOT commit .env.prod.
#   cp .env.prod.example .env.prod
# Generate secrets:
#   openssl rand -hex 32     # for the JWT secrets
#   openssl rand -hex 32     # for CREDENTIALS_ENC_KEY (must be exactly 64 hex chars)

# ── App ──────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
# Frontend origin(s) allowed by CORS. Comma-separated, no trailing slash.
CORS_ORIGINS=https://v2.bizzengager.com
# Absolute base URL of the API — used to build upload/image URLs. MUST be the API domain.
PUBLIC_BASE_URL=https://v2.api.bizzengager.com

# Compile-time API origin baked into the frontend build.
VITE_API_URL=https://v2.api.bizzengager.com

# ── Database (MySQL) ─────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=bizzengager
DB_USER=bizz
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_LOGGING=false

# ── Redis ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Set a password in production. Leave blank only if Redis is fully network-isolated.
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_DB=0

# ── Auth / JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_different_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CREDENTIALS_ENC_KEY=CHANGE_ME_exactly_64_hex_chars_openssl_rand_hex_32

# ── Two-Factor / OTP ─────────────────────────────────
OTP_TTL_SECONDS=300
TOTP_ISSUER=BizzEngager

# ── Campaign throughput ──────────────────────────────
CAMPAIGN_WORKER_CONCURRENCY=25
CAMPAIGN_DEFAULT_RATE_PER_SEC=20

# ── Meta WhatsApp Cloud API ──────────────────────────
META_WA_API_VERSION=v21.0
META_WA_BASE_URL=https://graph.facebook.com
META_WA_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_webhook_verify_token

# Optional — enables the Unsplash stock-photo tab in the Frame Editor.
UNSPLASH_ACCESS_KEY=

# ── Seed superadmin (npm run db:seed) ────────────────
SEED_SUPERADMIN_NAME=Platform Owner
SEED_SUPERADMIN_EMAIL=owner@bizzengager.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
