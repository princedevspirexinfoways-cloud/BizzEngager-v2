{
  "name": "bizzengager",
  "version": "0.1.0",
  "private": true,
  "description": "BizzEngager - multi-tenant bulk WhatsApp/Email/SMS campaign platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
